NODE_ENV=production
APP_BASE_URL=https://your-deployed-domain.example
SESSION_SECRET=<generate-a-long-random-secret>
DATABASE_URL=postgresql://postgres:<database-password>@db.<project-ref>.supabase.co:5432/postgres
# Set DATABASE_SSL=false only for a local PostgreSQL server.
DATABASE_SSL=true
# Persistent photo storage (keep this server-only key secret; never expose it to the browser).
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SECRET_KEY=<server-only-secret-key>
# Older Supabase projects may use this legacy name instead:
# SUPABASE_SERVICE_ROLE_KEY=<server-only-service-role-key>
SUPABASE_STORAGE_BUCKET=item-photos
ADMIN_EMAIL=admin@cspc.edu.ph
ADMIN_PASSWORD=<at-least-12-characters-for-first-production-start>
# Set true temporarily to reset an existing admin password on every app startup; change back to false after login works.
ADMIN_PASSWORD_RESET=false
ADMIN_NAME=System Admin
SMTP_HOST=<your-smtp-host>
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=<your-mailbox-address>
SMTP_PASS=<your-mailbox-password>
SMTP_FROM="Back2You <your-mailbox-address>"
# DATA_DIR is optional and only controls temporary uploads/session files until photo storage is migrated.

# Report assistant (optional). Without a key the assistant still works, using the built-in
# deterministic campus parser. Setting a key adds a Claude pass for messier sentences.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

# Messenger (optional). Page Access Token from Meta for Developers > your App > Messenger API Settings.
MESSENGER_PAGE_ACCESS_TOKEN=<your-page-access-token>
# Any random string you choose; must match the Verify Token entered in the Messenger webhook config.
MESSENGER_VERIFY_TOKEN=<choose-a-random-string>
# Optional: your Page's Messenger link (e.g. https://m.me/your-page-username), shown as a button
# when a student requests a link code, so they can message the Page in one click.
MESSENGER_PAGE_URL=